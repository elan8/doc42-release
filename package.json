{
  "name": "doc42-documentation",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev site --host 127.0.0.1",
    "docs:build": "npm run docs:prepare && vitepress build site",
    "docs:preview": "vitepress preview site --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.21",
    "vue": "3.5.45"
  }
}
